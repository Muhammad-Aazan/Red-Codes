{
  "name": "red-codes",
  "version": "1.0.0",
  "description": "RED CODES - Private Application Launcher for Windows",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "launcher",
    "private",
    "vault",
    "windows"
  ],
  "author": "RED CODES",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "cross-env": "^7.0.3",
    "electron": "^28.1.4",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "framer-motion": "^11.0.3",
    "lucide-react": "^0.316.0",
    "nodemailer": "^10.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "sql.js": "^1.12.0"
  },
  "build": {
    "appId": "com.redcodes.launcher",
    "productName": "RED CODES",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ]
  }
}
